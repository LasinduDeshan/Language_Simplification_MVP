{
  "$defs": {
    "GovernanceMetadata": {
      "additionalProperties": false,
      "properties": {
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "draft",
          "description": "Workflow status"
        },
        "research_eligibility_status": {
          "$ref": "#/$defs/ResearchEligibilityStatus",
          "default": "not_assessed",
          "description": "Formal research assessment status"
        },
        "research_eligible": {
          "default": false,
          "description": "Research readiness flag",
          "title": "Research Eligible",
          "type": "boolean"
        },
        "approved_for_child_delivery": {
          "default": false,
          "description": "Runtime child presentation flag",
          "title": "Approved For Child Delivery",
          "type": "boolean"
        },
        "is_simulated": {
          "default": false,
          "description": "Simulation or synthetic flag",
          "title": "Is Simulated",
          "type": "boolean"
        },
        "contains_personal_data": {
          "default": false,
          "description": "Personal/screening data flag",
          "title": "Contains Personal Data",
          "type": "boolean"
        }
      },
      "title": "GovernanceMetadata",
      "type": "object"
    },
    "LanguageCode": {
      "enum": [
        "en",
        "si"
      ],
      "title": "LanguageCode",
      "type": "string"
    },
    "ResearchEligibilityStatus": {
      "enum": [
        "not_assessed",
        "ineligible",
        "eligible",
        "withdrawn"
      ],
      "title": "ResearchEligibilityStatus",
      "type": "string"
    },
    "RightsMetadata": {
      "additionalProperties": false,
      "properties": {
        "licence_id": {
          "default": "project-internal",
          "description": "SPDX licence identifier or project-internal",
          "title": "Licence Id",
          "type": "string"
        },
        "licence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Web link to licence terms",
          "title": "Licence Url"
        },
        "permission_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Permission identifier or document reference",
          "title": "Permission Reference"
        },
        "redistribution_allowed": {
          "default": false,
          "description": "Whether dataset allows redistribution",
          "title": "Redistribution Allowed",
          "type": "boolean"
        },
        "commercial_use_allowed": {
          "default": false,
          "description": "Whether commercial use is permitted",
          "title": "Commercial Use Allowed",
          "type": "boolean"
        },
        "external_api_processing_allowed": {
          "default": false,
          "description": "Strict LLM API gating",
          "title": "External Api Processing Allowed",
          "type": "boolean"
        }
      },
      "title": "RightsMetadata",
      "type": "object"
    },
    "SourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "$ref": "#/$defs/SourceType",
          "default": "team_authored",
          "description": "Origin classification of the content"
        },
        "source_name": {
          "default": "Component 3 English MVP",
          "description": "Author or originating dataset",
          "title": "Source Name",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original identifier in upstream source system",
          "title": "Source Record Id"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL reference to source",
          "title": "Source Url"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Academic or publication citation",
          "title": "Citation"
        },
        "created_by_role": {
          "default": "project_team",
          "description": "Role of creator (project_team/expert/system)",
          "title": "Created By Role",
          "type": "string"
        },
        "created_at": {
          "description": "Creation timestamp",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "title": "SourceMetadata",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "team_authored",
        "expert_authored",
        "open_licence",
        "permission_granted",
        "generated",
        "interaction_derived"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "ValidationStatus": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "rejected",
        "retired"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entry_id": {
      "description": "Unique lexicon entry identifier (e.g. LEX-EN-000001)",
      "title": "Entry Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Schema version",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_version": {
      "default": "0.1.0",
      "description": "Dataset content release version",
      "title": "Dataset Version",
      "type": "string"
    },
    "language": {
      "$ref": "#/$defs/LanguageCode",
      "default": "en",
      "description": "Language code"
    },
    "word": {
      "description": "Target headword or complex lemma",
      "minLength": 1,
      "title": "Word",
      "type": "string"
    },
    "normalized_form": {
      "description": "Lowercased stripped normalized word",
      "minLength": 1,
      "title": "Normalized Form",
      "type": "string"
    },
    "part_of_speech": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Part of speech (noun/verb/adjective/preposition)",
      "title": "Part Of Speech"
    },
    "age_band": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Target developmental age band (e.g. 4-6, 6-8)",
      "title": "Age Band"
    },
    "difficulty_tier": {
      "default": 2,
      "description": "Tier (1=basic, 2=academic/high-freq, 3=domain specific)",
      "maximum": 3,
      "minimum": 1,
      "title": "Difficulty Tier",
      "type": "integer"
    },
    "simpler_alternatives": {
      "description": "Child-friendly substitution candidates",
      "items": {
        "type": "string"
      },
      "title": "Simpler Alternatives",
      "type": "array"
    },
    "child_friendly_definition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Simple child-friendly explanation",
      "title": "Child Friendly Definition"
    },
    "example_sentence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Illustrative example sentence",
      "title": "Example Sentence"
    },
    "source": {
      "$ref": "#/$defs/SourceMetadata",
      "description": "Lineage metadata"
    },
    "rights": {
      "$ref": "#/$defs/RightsMetadata",
      "description": "Rights metadata"
    },
    "governance": {
      "$ref": "#/$defs/GovernanceMetadata",
      "description": "Governance metadata"
    },
    "created_at": {
      "description": "Creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "description": "Update timestamp",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "entry_id",
    "word",
    "normalized_form"
  ],
  "title": "LexiconEntryV1",
  "type": "object"
}