{
  "$defs": {
    "Outcome": {
      "enum": [
        "correct",
        "partially_correct",
        "incorrect",
        "skipped",
        "adult_support_required",
        "in_progress"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "PrimaryDomain": {
      "enum": [
        "vocabulary",
        "grammar",
        "comprehension",
        "instruction_following"
      ],
      "title": "PrimaryDomain",
      "type": "string"
    },
    "ResponseMode": {
      "enum": [
        "manual",
        "speech",
        "touch",
        "ar_interaction",
        "imported"
      ],
      "title": "ResponseMode",
      "type": "string"
    },
    "SupportLevel": {
      "enum": [
        "mild",
        "moderate",
        "strong"
      ],
      "title": "SupportLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "interaction_id": {
      "description": "De-identified interaction ID",
      "title": "Interaction Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Schema version",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_version": {
      "default": "0.1.0",
      "description": "Dataset version",
      "title": "Dataset Version",
      "type": "string"
    },
    "learner_id": {
      "description": "Pseudonymous learner identifier",
      "title": "Learner Id",
      "type": "string"
    },
    "activity_id": {
      "description": "Activity identifier",
      "title": "Activity Id",
      "type": "string"
    },
    "primary_domain": {
      "$ref": "#/$defs/PrimaryDomain",
      "description": "Primary domain"
    },
    "occurred_at": {
      "description": "Occurrence timestamp",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "attempt_number": {
      "description": "Attempt sequence number",
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "support_level_used": {
      "$ref": "#/$defs/SupportLevel",
      "description": "Support tier used"
    },
    "response_mode": {
      "$ref": "#/$defs/ResponseMode",
      "description": "Response input channel"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome",
      "description": "Outcome evaluation"
    },
    "error_categories": {
      "description": "Observed language error categories",
      "items": {
        "type": "string"
      },
      "title": "Error Categories",
      "type": "array"
    },
    "response_time_ms": {
      "description": "Response latency in ms",
      "minimum": 0,
      "title": "Response Time Ms",
      "type": "integer"
    },
    "score_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Score delta",
      "title": "Score Delta"
    },
    "local_preliminary_trend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Local preliminary trend indicator for Component 4",
      "title": "Local Preliminary Trend"
    }
  },
  "required": [
    "interaction_id",
    "learner_id",
    "activity_id",
    "primary_domain",
    "occurred_at",
    "attempt_number",
    "support_level_used",
    "response_mode",
    "outcome",
    "response_time_ms"
  ],
  "title": "DeidentifiedInteractionExportV1",
  "type": "object"
}