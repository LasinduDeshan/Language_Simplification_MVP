# ==============================================================================
# Backend Environment Configuration - English-First Adaptive MVP (v2.2)
# ==============================================================================
# Copy this file to '.env' in the same directory (backend/.env):
#   cp .env.example .env
#
# NOTE: The system is designed with a 100% OFFLINE guarantee!
# All rule generation, personalization, safety checks, and simulated LLM
# features operate out-of-the-box with NO external API keys required.
# ==============================================================================

# --- Application Settings ---
APP_NAME="Language Simplification MVP"
ENVIRONMENT=development
DEBUG=True

# --- Security & CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Database Configuration ---
# Defaults to SQLite in the backend directory: backend/adaptive_learning.db
DATABASE_URL=sqlite:///./adaptive_learning.db

# --- LLM Provider & Generation Settings ---
# Options for LLM_PROVIDER: "google", "openai", "simulated"
# (If API keys are left blank, the system automatically falls back to simulated mode)
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_TEMPERATURE=0.2
LLM_MAX_REGENERATIONS=1

# --- Optional External LLM API Keys ---
# Leave blank to run 100% offline using deterministic rule engine + simulated LLM
# Google Gemini API key: Get from https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API key: Get from https://platform.openai.com/
OPENAI_API_KEY=
